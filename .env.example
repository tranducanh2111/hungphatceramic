# Public site origin (drives canonical URLs, hreflang, sitemap, Open Graph, and JSON-LD).
# Set in Vercel → Project → Settings → Environment Variables (never commit real .env files).
#
# Production deployment (main branch / perla.com.vn):
#   SITE_URL=https://perla.com.vn
#
# Preview / staging deployment (staging branch / perlaceramic.vercel.app):
#   SITE_URL=https://perlaceramic.vercel.app
#
# Local development (optional — defaults to http://localhost:3000 when unset):
#   SITE_URL=http://localhost:3000
SITE_URL=

# Google Search Console verification (optional — falls back to repo default when unset)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
